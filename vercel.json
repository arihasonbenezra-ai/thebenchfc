{
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ],
  "rewrites": [
    { "source": "/join/:path*", "destination": "/join/index.html" },
    { "source": "/match/:path*", "destination": "/join/index.html" }
  ]
}
